# Copiez ce fichier en .env puis complétez-le. Ne publiez jamais le fichier .env.

# Adresse qui reçoit les demandes de devis
MAIL_TO=call19production@gmail.com

# Serveur d'envoi. Avec Gmail, SMTP_PASS est un « mot de passe d'application »
# (myaccount.google.com/apppasswords ; la validation en deux étapes doit être activée).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=call19production@gmail.com
SMTP_PASS=

# Expéditeur affiché (facultatif ; par défaut « Site Call 19 Production » <SMTP_USER>)
# MAIL_FROM="Site Call 19 Production <call19production@gmail.com>"

# Si le site est servi par un autre hébergement que ce serveur : origines autorisées, séparées par des virgules
# ALLOWED_ORIGINS=https://www.exemple.ma

# Port du serveur (l'hébergeur impose souvent le sien)
PORT=3019
